# Printify personal access token (Printify > My account > Connections > API)
PRINTIFY_TOKEN=

# Default Printify shop used for price probes and product creation (optional, can be picked in the UI)
PRINTIFY_SHOP_ID=

# PostgreSQL connection
DATABASE_URL=postgres://postgres:password@localhost:5432/printify

# HTTP port for the app
PORT=3000

# Where uploaded layers and rendered print files are stored
STORAGE_DIR=./storage

# Optional: publicly reachable base URL that serves STORAGE_DIR/renders (e.g. an ngrok tunnel).
# When set, print files are uploaded to Printify by URL instead of base64 (better for files > 5MB).
PUBLIC_BASE_URL=
